* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #07121f;
    color: white;
}


/* Header */

header {
    height: 70px;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;

    background: rgba(7, 18, 31, 0.95);

    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 24px;
    font-weight: bold;
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    color: #c7d8ea;
    text-decoration: none;
}

nav a:hover {
    color: #45b8ff;
}


/* Hero */

.hero {
    min-height: 560px;
    padding: 80px 8%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background:
        radial-gradient(circle at 80% 50%,
        #124c70 0%,
        #07121f 45%);
}

.hero-content {
    max-width: 650px;
}

.tag {
    color: #45b8ff;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
}

.hero h1 {
    font-size: 55px;
    line-height: 1.1;
    margin: 20px 0;
}

.hero h1 span {
    color: #45b8ff;
}

.hero p {
    color: #bfd0df;
    font-size: 18px;
    line-height: 1.7;
    margin-bottom: 30px;
}

.hero-btn {
    display: inline-block;
    padding: 15px 25px;

    background: #168bd1;
    color: white;

    text-decoration: none;

    border-radius: 10px;

    font-weight: bold;
}

.hero-btn:hover {
    transform: translateY(-2px);
}

.hero-icon {
    font-size: 180px;
}


/* Sections */

.section {
    padding: 70px 8%;
}

.section h2,
.progress-section h2 {
    text-align: center;
    font-size: 32px;
}

.section-subtitle {
    text-align: center;
    color: #aebfd0;
    margin-top: 10px;
}


/* Search */

.search-box {
    max-width: 600px;
    margin: 30px auto;
}

.search-box input {
    width: 100%;
    padding: 16px;

    border-radius: 10px;
    border: none;

    font-size: 16px;

    outline: none;
}


/* Topic Grid */

.topic-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 22px;
}

.topic-card {
    padding: 25px;

    background: rgba(255, 255, 255, 0.06);

    border: 1px solid
        rgba(255, 255, 255, 0.1);

    border-radius: 18px;

    transition: 0.3s;
}

.topic-card:hover {
    transform: translateY(-6px);
    border-color: #45b8ff;
}

.topic-icon {
    font-size: 40px;
    margin-bottom: 15px;
}

.topic-card h3 {
    margin-bottom: 10px;
}

.topic-card p {
    color: #b8c9d8;
    line-height: 1.6;
    margin-bottom: 20px;
}

.topic-card button {
    padding: 10px 16px;

    border: none;
    border-radius: 8px;

    background: #168bd1;
    color: white;

    cursor: pointer;
}


/* Modal */

.modal {
    display: none;

    position: fixed;

    inset: 0;

    background: rgba(0, 0, 0, 0.75);

    z-index: 200;

    align-items: center;
    justify-content: center;

    padding: 20px;
}

.modal-content {
    max-width: 550px;

    background: #102538;

    padding: 35px;

    border-radius: 18px;

    position: relative;
}

.modal-content h2 {
    margin-bottom: 15px;
}

.modal-content p {
    color: #c7d8e8;
    line-height: 1.7;
}

.close {
    position: absolute;

    top: 10px;
    right: 15px;

    border: none;
    background: none;

    color: white;

    font-size: 30px;

    cursor: pointer;
}


/* Progress */

.progress-section {
    padding: 60px 8%;

    background: rgba(255, 255, 255, 0.03);
}

.progress-box {
    max-width: 700px;
    margin: 30px auto;
}

.progress-info {
    display: flex;
    justify-content: space-between;

    margin-bottom: 10px;
}

.progress-bar {
    width: 100%;
    height: 15px;

    background: #263b4d;

    border-radius: 20px;

    overflow: hidden;
}

.progress-fill {
    width: 0%;

    height: 100%;

    background: #45b8ff;

    transition: 0.5s;
}


/* Quiz */

.quiz-section {
    background: #0a1928;
}

.quiz-card {
    max-width: 650px;

    margin: 35px auto 0;

    padding: 30px;

    background: rgba(255, 255, 255, 0.06);

    border-radius: 18px;

    text-align: center;
}

.quiz-card h3 {
    line-height: 1.5;
    margin-bottom: 25px;
}

.options {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 12px;
}

.options button {
    padding: 14px;

    border: none;
    border-radius: 9px;

    background: #1b344b;

    color: white;

    cursor: pointer;
}

.options button:hover {
    background: #168bd1;
}

#quizResult {
    margin-top: 20px;

    font-weight: bold;
}

.next-btn {
    margin-top: 20px;

    padding: 12px 20px;

    border: none;
    border-radius: 9px;

    background: #168bd1;

    color: white;

    cursor: pointer;
}


/* About */

.about {
    text-align: center;

    padding: 70px 10%;

    background:
        linear-gradient(
            135deg,
            #0c263c,
            #07121f
        );
}

.about h2 {
    margin-bottom: 20px;
}

.about p {
    max-width: 700px;

    margin: auto;

    color: #bdcede;

    line-height: 1.7;
}


/* Footer */

footer {
    text-align: center;

    padding: 30px;

    color: #9eb2c4;
}

footer h3 {
    color: white;

    margin-bottom: 8px;
}

footer small {
    display: block;

    margin-top: 10px;
}


/* Mobile */

@media (max-width: 750px) {

    header {
        padding: 15px 5%;
    }

    nav {
        display: none;
    }

    .hero {
        text-align: center;
        padding: 60px 7%;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero-icon {
        display: none;
    }

    .topic-grid {
        grid-template-columns: 1fr;
    }

    .options {
        grid-template-columns: 1fr;
    }
}
